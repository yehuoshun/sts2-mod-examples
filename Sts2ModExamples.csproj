<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyName>Sts2ModExamples</AssemblyName>
        <RootNamespace>Sts2ModExamples</RootNamespace>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>packages/**</DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
        <NoWarn>$(NoWarn);MSB3270;CS0436;CS9057;STS001;STS003</NoWarn>
        <!-- 打开 MonoMod detour 对照示例：dotnet build -p:MONOMOD_DETOUR=true（默认关闭，保持纯原生） -->
        <DefineConstants Condition="'$(MONOMOD_DETOUR)' == 'true'">$(DefineConstants);MONOMOD_DETOUR</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- 可选：AutoAnthony（第三方工坊 mod，不在 CI 依赖里）。
         装了 → Cardgen/ 参与编译，编译期锁死卡片编辑/组件注册 API 签名；
         没装 → 整个 Cardgen/ 目录 Compile Remove，CI 照常全绿。
         默认从 Steam 注册表推工坊目录，也可 -p:AutoAnthonyDir=... 或设环境变量覆盖。 -->
    <PropertyGroup>
        <!-- 工坊目录 = <Steam 库根>/workshop/content/2868840/<publishedfileid>。
             库根优先从实际找到游戏的那条路径反推（Sts2Path 可能是注册表路径而非默认 Steam 库），
             再退回 SteamLibraryPath / AutoSteamPath。 -->
        <AutoAnthonyDir Condition="'$(AutoAnthonyDir)' == '' and Exists('$(Sts2Path)/../../workshop/content/2868840/3786611028/AutoAnthony.dll')">$(Sts2Path)/../../workshop/content/2868840/3786611028</AutoAnthonyDir>
        <AutoAnthonyDir Condition="'$(AutoAnthonyDir)' == '' and Exists('$(SteamLibraryPath)/workshop/content/2868840/3786611028/AutoAnthony.dll')">$(SteamLibraryPath)/workshop/content/2868840/3786611028</AutoAnthonyDir>
        <AutoAnthonyDir Condition="'$(AutoAnthonyDir)' == '' and Exists('$(AutoSteamPath)/workshop/content/2868840/3786611028/AutoAnthony.dll')">$(AutoSteamPath)/workshop/content/2868840/3786611028</AutoAnthonyDir>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(AutoAnthonyDir)/AutoAnthony.dll')">
        <Reference Include="AutoAnthony">
            <HintPath>$(AutoAnthonyDir)/AutoAnthony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="!Exists('$(AutoAnthonyDir)/AutoAnthony.dll')">
        <Compile Remove="Sts2ModExamplesCode/Cardgen/**/*.cs" />
    </ItemGroup>

    <Target Name="ReportAutoAnthonyAvailability" BeforeTargets="CoreCompile">
        <Message Condition="Exists('$(AutoAnthonyDir)/AutoAnthony.dll')" Importance="high"
                 Text="AutoAnthony.dll 已找到（$(AutoAnthonyDir)）→ Cardgen 示例参与编译" />
        <Message Condition="!Exists('$(AutoAnthonyDir)/AutoAnthony.dll')" Importance="high"
                 Text="AutoAnthony.dll 未找到 → 跳过 Cardgen 编译（CI 与未装 mod 的机器走这条）" />
    </Target>

    <!-- 可选构建期工具（非运行时依赖）：
         官方静态分析器 ModAnalyzers + Publicizer（publicize sts2 非 virtual 成员） -->
    <ItemGroup Condition="'$(PublicizeSts)' != 'false'">
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All" />
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />

        <AdditionalFiles Include="Sts2ModExamples/localization/**/*.json" />
    </ItemGroup>

    <!-- 可选：MonoMod detour 对照示例（Harmony 之外第二种运行时改写方案）。
         默认不引入，保持「纯原生 = 0Harmony.dll + sts2.dll」；
         开启：dotnet build -c Release -p:MONOMOD_DETOUR=true
         PrivateAssets=All：编译期可解析类型，但不进产物（运行时要另带 MonoMod 依赖包）。 -->
    <ItemGroup Condition="'$(MONOMOD_DETOUR)' == 'true'">
        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.0.2" PrivateAssets="All" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths" BeforeTargets="CoreCompile">
        <Error Text="Slay the Spire 2 data not found at '$(Sts2DataDir)'. 游戏未安装或 Sts2PathDiscovery.props 未命中，可用 -p:Sts2DataDir= 覆盖。"
               Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)/sts2.dll')" />
    </Target>

    <!-- 构建后自动部署到游戏 mods 目录 -->
    <Target Name="CopyToModsFolderOnBuild" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)/Sts2ModExamples.json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)/Sts2ModExamples.pck" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" Condition="Exists('$(MSBuildProjectDirectory)/Sts2ModExamples.pck')" />
        <Message Text="已部署到 $(ModsPath)$(MSBuildProjectName)/" Importance="high" />
    </Target>
</Project>
